MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_DATABASE=teacup_picture
MYSQL_USER=teacup
MYSQL_PASSWORD=replace-with-a-long-random-application-password
MYSQL_HOST_PORT=13306

REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_HOST_PORT=16379

RABBITMQ_USERNAME=teacup
RABBITMQ_PASSWORD=replace-with-a-long-random-rabbitmq-password
RABBITMQ_VHOST=/teacup-picture
RABBITMQ_HOST_PORT=15672
RABBITMQ_MANAGEMENT_HOST_PORT=15673

MINIO_ROOT_USER=teacup-minio-root
MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-root-password
MINIO_APP_ACCESS_KEY=teacup-picture-app
MINIO_APP_SECRET_KEY=replace-with-a-long-random-minio-application-secret
MINIO_BUCKET=teacup-pictures
MINIO_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001

# Imported by Spring as .properties; do not wrap these values in quotes.
OPENAI_API_BASE_URL=https://claudenb.com
OPENAI_API_KEY=
OPENAI_IMAGE_TIMEOUT_MS=120000
AI_WORKER_CONCURRENCY=4
AI_PROVIDER_GLOBAL_CONCURRENCY=12
AI_PROVIDER_REQUESTS_PER_MINUTE=60
AI_PROVIDER_BURST_CAPACITY=4
AI_WORKER_LEASE_SECONDS=300
AI_WORKER_MAX_ATTEMPTS=4
AI_WORKER_SHUTDOWN_AWAIT_SECONDS=180
AI_OUTBOX_RETENTION_DAYS=7
